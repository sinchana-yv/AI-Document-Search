# Backend Environment Configuration

# Application Settings
PROJECT_NAME="AI Document Search Chatbot (RAG)"
API_V1_STR="/api/v1"
DEBUG=True

# Security & JWT Authentication
# Generate secret key using command: openssl rand -hex 32
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER="rag_user"
POSTGRES_PASSWORD="rag_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="rag_chatbot_db"
DATABASE_URL="postgresql://rag_user:rag_password@localhost:5432/rag_chatbot_db"

# Redis Cache Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379/0"

# Vector Database (Pinecone)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-east-1"
PINECONE_INDEX_NAME="rag-document-index"

# OpenAI API Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_LLM_MODEL="gpt-4o"
